{
  "expo": {
    "name": "Creator Studio by AIMD",
    "slug": "aimd-network",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aimd-network",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F3EA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.replit.creatorstudiobyaimd"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/aimd-adaptive-foreground.png",
        "backgroundImage": "./assets/images/aimd-adaptive-background.png",
        "backgroundColor": "#F8F3EA"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "@clerk/expo",
      "expo-font",
      "expo-web-browser",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Creator Studio by AIMD to record live drill and challenge footage.",
          "microphonePermission": "Allow Creator Studio by AIMD to record sound with drill and challenge footage.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Creator Studio by AIMD to choose photos or videos for posts, profile images, and habit practice proof.",
          "cameraPermission": "Allow Creator Studio by AIMD to take habit practice photos and capture live challenge proof.",
          "microphonePermission": "Allow Creator Studio by AIMD to record sound with creator videos."
        }
      ],
      "expo-asset",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
