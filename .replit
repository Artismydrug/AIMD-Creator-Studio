modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "gallery-catalog-contract"

[[workflows.workflow]]
name = "gallery-catalog-contract"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run check:gallery-contract"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["ffmpeg"]

[userenv]

[userenv.shared]
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY = "appl_gaZCJhQrWznvmyNQqCpyNBuYsjG"
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY = "test_slWEFggtpJaUuAfgffMSwHTskBZ"
REVENUECAT_APPLE_APP_STORE_APP_ID = "appb8fd995bb9"
REVENUECAT_PROJECT_ID = "proj04da7090"
REVENUECAT_TEST_STORE_APP_ID = "app0e01189c75"
REVENUECAT_ACADEMY_ENTITLEMENT_ID = "entle6663f1821"
REVENUECAT_PRO_ENTITLEMENT_ID = "entlcec82665af"

[objectStorage]
defaultBucketID = "replit-objstore-cd9323ce-8c54-4b2e-8bd1-feb1800a202a"
